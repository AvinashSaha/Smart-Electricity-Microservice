{
  "info": {
    "name": "North East Smart Electricity (API v1)",
    "description": "Every microservice API through the API gateway. Change city / provider in the variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "city",
      "value": "newcastle"
    },
    {
      "key": "provider",
      "value": "a"
    }
  ],
  "item": [
    {
      "name": "Electricity provider",
      "item": [
        {
          "name": "Receive reading",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/provider-{{city}}-{{provider}}/api/v1/readings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "provider-{{city}}-{{provider}}",
                "api",
                "v1",
                "readings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"citizenId\": \"TEST-CITIZEN-1\",\n  \"meterType\": \"MANUAL\",\n  \"readingKwh\": 1000.5\n}"
            }
          }
        },
        {
          "name": "Latest readings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/provider-{{city}}-{{provider}}/api/v1/readings?limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "provider-{{city}}-{{provider}}",
                "api",
                "v1",
                "readings"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Monthly totals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/provider-{{city}}-{{provider}}/api/v1/consumption/monthly?months=12",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "provider-{{city}}-{{provider}}",
                "api",
                "v1",
                "consumption",
                "monthly"
              ],
              "query": [
                {
                  "key": "months",
                  "value": "12"
                }
              ]
            }
          }
        },
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/provider-{{city}}-{{provider}}/api/v1/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "provider-{{city}}-{{provider}}",
                "api",
                "v1",
                "summary"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Smart city",
      "item": [
        {
          "name": "Aggregates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/smartcity-{{city}}/api/v1/aggregates?months=12",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "smartcity-{{city}}",
                "api",
                "v1",
                "aggregates"
              ],
              "query": [
                {
                  "key": "months",
                  "value": "12"
                }
              ]
            }
          }
        },
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/smartcity-{{city}}/api/v1/summary?months=12",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "smartcity-{{city}}",
                "api",
                "v1",
                "summary"
              ],
              "query": [
                {
                  "key": "months",
                  "value": "12"
                }
              ]
            }
          }
        },
        {
          "name": "Collect now",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/smartcity-{{city}}/api/v1/aggregates/collect",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "smartcity-{{city}}",
                "api",
                "v1",
                "aggregates",
                "collect"
              ]
            }
          }
        },
        {
          "name": "Provider status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/smartcity-{{city}}/api/v1/providers/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "smartcity-{{city}}",
                "api",
                "v1",
                "providers",
                "status"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Citizen",
      "item": [
        {
          "name": "List citizens",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/citizen-{{city}}/api/v1/citizens?provider={{provider}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "citizen-{{city}}",
                "api",
                "v1",
                "citizens"
              ],
              "query": [
                {
                  "key": "provider",
                  "value": "{{provider}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get citizen",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/citizen-{{city}}/api/v1/citizens/NEWCASTLE-A-M001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "citizen-{{city}}",
                "api",
                "v1",
                "citizens",
                "NEWCASTLE-A-M001"
              ]
            }
          }
        },
        {
          "name": "Manual entry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/citizen-{{city}}/api/v1/citizens/NEWCASTLE-A-M001/readings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "citizen-{{city}}",
                "api",
                "v1",
                "citizens",
                "NEWCASTLE-A-M001",
                "readings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"readingKwh\": 99999.5\n}"
            }
          }
        },
        {
          "name": "Simulation status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/citizen-{{city}}/api/v1/simulation/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "citizen-{{city}}",
                "api",
                "v1",
                "simulation",
                "status"
              ]
            }
          }
        }
      ]
    }
  ]
}
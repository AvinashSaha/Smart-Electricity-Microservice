{
  "info": {
    "name": "Smart Electricity Microservice (SDEM)",
    "description": "All SDEM endpoints through the API gateway. Change the baseUrl variable to call a service directly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Electricity providers",
      "item": [
        {
          "name": "List providers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/providers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "providers"
              ]
            }
          }
        },
        {
          "name": "Get provider",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/providers/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "providers",
                "1"
              ]
            }
          }
        },
        {
          "name": "Cheapest provider",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/providers/cheapest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "providers",
                "cheapest"
              ]
            }
          }
        },
        {
          "name": "Create provider",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/providers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "providers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Metro Solar\",\n  \"unitRatePence\": 23.8,\n  \"standingChargePence\": 55.0,\n  \"renewablePercent\": 70\n}"
            }
          }
        },
        {
          "name": "Update provider",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/providers/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "providers",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Northern Power Co\",\n  \"unitRatePence\": 24.1,\n  \"standingChargePence\": 53.35,\n  \"renewablePercent\": 40\n}"
            }
          }
        },
        {
          "name": "Deactivate provider",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/providers/4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "providers",
                "4"
              ]
            }
          }
        },
        {
          "name": "Bill quote",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/providers/1/quote?kwh=250&days=30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "providers",
                "1",
                "quote"
              ],
              "query": [
                {
                  "key": "kwh",
                  "value": "250"
                },
                {
                  "key": "days",
                  "value": "30"
                }
              ]
            }
          }
        }
      ]
    },
